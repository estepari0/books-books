# Copy this file to .env.local and fill in the value. .env.local is git-ignored.
# Never put a real token in this example file.

# Notion internal integration token ("book cleanup" integration).
# Notion → Settings → Connections → book cleanup → Manage → Copy API token.
# The same value must also be set as NOTION_TOKEN in Vercel (Settings → Environment Variables).
NOTION_TOKEN=
